    <Box style={{ height: 592, paddingLeft: 60, paddingRight: 60, paddingTop: 32, paddingBottom: 18, flexDirection: 'column' }}>
        <Text style={{ fontSize: 19, lineHeight: 1.6, color: '#4A5568' }}>动手切块之前，先写了两个只读脚本遍历全书，把字号、字体、书签、页边文本全部统计一遍。结论与「通用 PDF 切块经验」有四处不一致。</Text>
        <Box style={{ height: 22 }} />
        <Table
            style={{ width: '100%', height: 356 }}
            defaultTextStyle={{ fontSize: 17, textAlign: 'left', color: '#1A2230' }}
            defaultCellStyle={{
                border: {
