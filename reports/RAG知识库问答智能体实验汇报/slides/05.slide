                },
            }}
            cells={[
                [
                    { text: '原本的预判', textStyle: { bold: true, color: '#1E4FA8', fontSize: 17 }, cellStyle: { background: { color: '#E8EFF8' } } },
                    { text: '实测发现', textStyle: { bold: true, color: '#1E4FA8', fontSize: 17 }, cellStyle: { background: { color: '#E8EFF8' } } },
                    { text: '对切块策略的影响', textStyle: { bold: true, color: '#1E4FA8', fontSize: 17 }, cellStyle: { background: { color: '#E8EFF8' } } },
                ],
                [
                    '要用正则合并 PDF 的硬换行',
                    '段落本身就是独立 block，换行只发生在 block 内部',
                    '取消全局合并，只在 block 内按中英规则拼接：中文直拼、英文补空格',
                ],
                [
                    '书签树能提供三级目录',
                    '书签只有一级 14 条、二级 101 条；正文另有 267 个 13pt 小节标题',
                    '改用字号重建层级（22pt 章 / 18pt 节 / 13pt 小节），比书签更细',
                ],
                [
                    '统计高频页眉页脚行并剔除',
                    '页边区域 608 种文本各只出现 1–3 次，全部是页码，高频法失效',
                    '改判据：9pt 且为纯数字 → 页码，直接丢弃',
                ],
                [
                    '按文字字体判断是否代码块',
                    'RobotoMono 占 22 万字符，正文里的英文单词也用它',
                    '改判据：一行内全部 span 均为等宽字体且占比 ≥ 60% → 代码块',
