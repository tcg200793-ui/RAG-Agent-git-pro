<Slide style={{ padding: 0, background: '#FFFFFF', flexDirection: 'column' }}>
    <Box style={{ height: 68, background: '#1E4FA8', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 60, paddingRight: 60 }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF' }}>主循环：检索几次，交给模型决定</Text>
        <Text style={{ fontSize: 15, color: '#B9CDEB', letterSpacing: 1 }}>03 · AGENT</Text>
    </Box>
    <Box style={{ height: 592, paddingLeft: 60, paddingRight: 60, paddingTop: 26, paddingBottom: 18, flexDirection: 'column' }}>
        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1E4FA8' }}>一次问答的完整链路</Text>
        <Box style={{ height: 14 }} />
        <Box style={{ flexDirection: 'row', justifyContent: 'space-between', height: 190 }}>
            <Box style={{ width: 196, height: 190, border: '1px solid #D6DCE5', paddingLeft: 14, paddingRight: 12, paddingTop: 14, flexDirection: 'column' }}>
                <Text style={{ fontSize: 12, color: '#3D7BD9', letterSpacing: 1 }}>STEP 1</Text>
                <Box style={{ height: 8 }} />
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1A2230', lineHeight: 1.35 }}>用户提问</Text>
                <Box style={{ height: 8 }} />
                <Text style={{ fontSize: 15, lineHeight: 1.6, color: '#4A5568' }}>自然语言，可口语化、可用英文命令</Text>
            </Box>
            <Text style={{ fontSize: 18, color: '#3D7BD9', lineHeight: 1 }}>→</Text>
            <Box style={{ width: 196, height: 190, border: '1px solid #D6DCE5', paddingLeft: 14, paddingRight: 12, paddingTop: 14, flexDirection: 'column' }}>
                <Text style={{ fontSize: 12, color: '#3D7BD9', letterSpacing: 1 }}>STEP 2</Text>
                <Box style={{ height: 8 }} />
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1A2230', lineHeight: 1.35 }}>模型判断要不要查</Text>
                <Box style={{ height: 8 }} />
                <Text style={{ fontSize: 15, lineHeight: 1.6, color: '#4A5568' }}>涉及命令、步骤、机制的问题必须先查</Text>
            </Box>
            <Text style={{ fontSize: 18, color: '#3D7BD9', lineHeight: 1 }}>→</Text>
            <Box style={{ width: 196, height: 190, background: '#E8EFF8', border: '1px solid #B9CDEB', paddingLeft: 14, paddingRight: 12, paddingTop: 14, flexDirection: 'column' }}>
                <Text style={{ fontSize: 12, color: '#3D7BD9', letterSpacing: 1 }}>STEP 3</Text>
                <Box style={{ height: 8 }} />
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1.35 }}>search_git_docs</Text>
                <Box style={{ height: 8 }} />
                <Text style={{ fontSize: 15, lineHeight: 1.6, color: '#4A5568' }}>query 与 top_k（1–8）由模型自己给</Text>
            </Box>
            <Text style={{ fontSize: 18, color: '#3D7BD9', lineHeight: 1 }}>→</Text>
            <Box style={{ width: 196, height: 190, border: '1px solid #D6DCE5', paddingLeft: 14, paddingRight: 12, paddingTop: 14, flexDirection: 'column' }}>
                <Text style={{ fontSize: 12, color: '#3D7BD9', letterSpacing: 1 }}>STEP 4</Text>
                <Box style={{ height: 8 }} />
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1A2230', lineHeight: 1.35 }}>原文回填上下文</Text>
                <Box style={{ height: 8 }} />
                <Text style={{ fontSize: 15, lineHeight: 1.6, color: '#4A5568' }}>每条带章节路径、页码、相似度</Text>
            </Box>
            <Text style={{ fontSize: 18, color: '#3D7BD9', lineHeight: 1 }}>→</Text>
            <Box style={{ width: 196, height: 190, border: '1px solid #D6DCE5', paddingLeft: 14, paddingRight: 12, paddingTop: 14, flexDirection: 'column' }}>
                <Text style={{ fontSize: 12, color: '#3D7BD9', letterSpacing: 1 }}>STEP 5</Text>
                <Box style={{ height: 8 }} />
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1A2230', lineHeight: 1.35 }}>作答或换词再检</Text>
                <Box style={{ height: 8 }} />
                <Text style={{ fontSize: 15, lineHeight: 1.6, color: '#4A5568' }}>上限 4 轮，到限强制基于现有材料作答</Text>
            </Box>
        </Box>
        <Box style={{ height: 26 }} />
        <Table
            style={{ width: '100%', height: 186 }}
            defaultTextStyle={{ fontSize: 16, textAlign: 'left', color: '#1A2230' }}
            defaultCellStyle={{
                border: {
                    left: { width: 0, color: '#FFFFFF' },
                    right: { width: 0, color: '#FFFFFF' },
                    top: { width: 0, color: '#FFFFFF' },
                    bottom: { width: 1, color: '#D6DCE5' },
                },
            }}
            cells={[
                [
                    { text: '与一次性 RAG 的差别', textStyle: { bold: true, color: '#1E4FA8' }, cellStyle: { background: { color: '#E8EFF8' } } },
                    { text: '一次性 RAG', textStyle: { bold: true, color: '#1E4FA8' }, cellStyle: { background: { color: '#E8EFF8' } } },
                    { text: '本项目（工具调用）', textStyle: { bold: true, color: '#1E4FA8' }, cellStyle: { background: { color: '#E8EFF8' } } },
                ],
                ['检索词来源', '代码里写死，直接用用户原句', '模型可改写：答非所问时换书里的说法再查'],
                ['检索次数', '固定 1 次', '模型决定，最多 4 轮'],
                ['答不出来时', '照样拼接上下文硬答', '可以判断「知识库没有」并指出最接近的章节'],
            ]}
        />
        <Box style={{ height: 18 }} />
        <Box style={{ height: 68, background: '#E8EFF8', paddingLeft: 24, paddingRight: 24, flexDirection: 'row', alignItems: 'center' }}>
            <Text style={{ fontSize: 19, lineHeight: 1.6, color: '#1A2230' }}>把「检索几次、检索什么」从代码搬到模型手里，<span style={{ fontWeight: 'bold', color: '#1E4FA8' }}>换来的是答错之后还有一次自救机会</span>——代价是要给轮次和 top_k 加硬上限。</Text>
        </Box>
    </Box>
    <Box style={{ height: 60, paddingLeft: 60, paddingRight: 60, paddingTop: 12, flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>基于 RAG 的 Git 知识库问答智能体 · 实验报告</Text>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>15 / 20</Text>
    </Box>
</Slide>
